  "captions": [
    {
      "start": 0.2,
      "end": 1.3,
      "text": "Okay, confession:",
      "style": "main",
      "popIn": true
    },
    {
      "start": 1.3,
      "end": 2.9,
      "text": "You think black coffee tastes",
      "style": "main",
      "popIn": false
    },
    {
      "start": 2.9,
      "end": 4.2,
      "text": "like burnt toast. Fair.",
      "style": "main",
      "popIn": false
    },
    {
      "start": 4.2,
      "end": 5.4,
      "text": "Most of it kinda does.",
      "style": "main",
      "popIn": true
    },
    {
      "start": 5.5,
      "end": 7.4,
      "text": "Bitterness usually comes from rushing.",
      "style": "main",
      "popIn": false
    },
    {
      "start": 7.4,
      "end": 9.3,
      "text": "We don't rush.",
      "style": "main",
      "popIn": true
    },
    {
      "start": 9.4,
      "end": 11,
      "text": "Slow-steeped for 18 whole hours",
      "style": "top",
      "popIn": true
    },
    {
      "start": 11,
      "end": 12.2,
      "text": "in small batches",
      "style": "top",
      "popIn": false
    },
    {
      "start": 12.2,
      "end": 13.9,
      "text": "deep, mellow, genuinely smooth.",
      "style": "top",
      "popIn": false
    },
    {
      "start": 13.9,
      "end": 15.3,
      "text": "Never bitter.",
      "style": "top",
      "popIn": true
    },
    {
      "start": 15.4,
      "end": 16.8,
      "text": "No added sugar.",
      "style": "top",
      "popIn": true
    },
    {
      "start": 16.8,
      "end": 18.9,
      "text": "Honestly? You won't miss it.",
      "style": "top",
      "popIn": false
    },
    {
      "start": 19,
      "end": 20.3,
      "text": "Just good coffee,",
      "style": "top",
      "popIn": true
    },
    {
      "start": 20.3,
      "end": 21.9,
      "text": "the way it should've tasted",
      "style": "top",
      "popIn": false
    },
    {
      "start": 21.9,
      "end": 22.8,
      "text": "all along.",
      "style": "top",
      "popIn": false
    },
    {
      "start": 22.8,
      "end": 24.9,
      "text": "In a slim can you take anywhere.",
      "style": "top",
      "popIn": true
    },
    {
      "start": 25,
      "end": 26.3,
      "text": "Grab a can from the fridge.",
      "style": "top",
