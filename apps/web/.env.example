# Supabase (M1+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only, NEVER prefixed NEXT_PUBLIC_, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build magic-link / invite redirect URLs (see src/app/login/actions.ts
# and the invite-link RPC once it's written). Session itself is Supabase
# Auth's own cookie-based session (see docs/adr/001-nextjs-cache-components.md)
# — no separate session secret of our own is needed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Workflow engine (M9+) — exact var names depend on the ADR 002 decision (Inngest vs Trigger.dev)

# Sentry (M0)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Per-org provider keys (Anthropic, kie.ai, fal.ai, ElevenLabs, TwelveLabs, Pexels, HeyGen) are
# NOT set here — they live encrypted in Supabase Vault per org_secrets (spec §2 rule 5, §4).
# This file only covers platform-level infrastructure secrets.
